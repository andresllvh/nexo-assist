# Chave do Gemini (gratuita em https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Modelo usado pelo agent (formato provedor/modelo do Mastra).
# O flash-lite é rápido, barato e tem cota gratuita própria; o google/gemini-3.5-flash decide um pouco melhor.
NEXO_MODEL=google/gemini-3.5-flash-lite
# Modelo da etapa de entendimento (classificação da mensagem): mais leve e barato
NEXO_ROUTER_MODEL=google/gemini-3.5-flash-lite

# Segredo para assinar o cookie de sessão (qualquer texto longo e aleatório)
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Banco: arquivo local por padrão. Em produção, a URL do Turso (a integração da Vercel cria
# TURSO_DATABASE_URL e TURSO_AUTH_TOKEN, que também são aceitas)
DATABASE_URL=file:data/nexo.db
DATABASE_AUTH_TOKEN=

# Limites de uso (protegem a versão publicada de abuso e custo): mensagens por funcionário por hora
# e respostas do agent com o modelo por dia, no sistema todo
NEXO_LIMIT_PER_HOUR=60
NEXO_LIMIT_PER_DAY=500

# Simulação do sistema de chamados legado: chance de falha por chamada (0 a 1)
TICKETS_FAILURE_RATE=0.1
