# Chave do Gemini (gratuita em https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# Modelo usado pelo agent (formato provedor/modelo do Mastra)
NEXO_MODEL=google/gemini-3.5-flash

# Segredo para assinar o cookie de sessão (qualquer texto longo e aleatório)
SESSION_SECRET=troque-por-um-texto-longo-e-aleatorio

# Banco: arquivo local por padrão; em produção pode ser uma URL do Turso
DATABASE_URL=file:data/nexo.db
DATABASE_AUTH_TOKEN=

# Simulação do sistema de chamados legado: chance de falha por chamada (0 a 1)
TICKETS_FAILURE_RATE=0.1
